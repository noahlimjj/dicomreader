{
  "name": "dicom-reader",
  "version": "0.1.0",
  "description": "DICOM viewer for iPhone, Android and the web",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "golden": "python -I test/tools/make_golden.py",
    "sample": "python -I test/tools/make_sample.py",
    "licenses": "node test/tools/licenses.mjs",
    "cap:sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios",
    "android": "vite build && cap sync android"
  },
  "author": "noahlimjj",
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@cornerstonejs/codec-charls": "^1.2.7",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.8",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@cornerstonejs/codec-openjph": "^2.4.11",
    "@dicomreader/folder-picker": "file:plugins/folder-picker",
    "@zip.js/zip.js": "^2.23.0",
    "dicom-parser": "^1.8.21",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
